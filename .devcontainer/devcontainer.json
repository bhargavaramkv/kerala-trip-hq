{
  "name": "Kerala Trip HQ",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "forwardPorts": [8080],
  "portsAttributes": { "8080": { "label": "Kerala Trip HQ", "onAutoForward": "silent" } },
  "remoteEnv": { "PORT": "8080", "DATA_DIR": "/workspaces/trip-data" },
  "postStartCommand": "bash .devcontainer/start.sh"
}
