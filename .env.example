# Public address of the deployed app, no trailing slash (needed for Google sign-in)
BASE_URL=https://your-app.example.com

# Where the database lives. Put this on a persistent disk/volume.
DATA_DIR=./data

# Secret used to sign sessions. Any long random string.
SESSION_SECRET=change-me-to-a-long-random-string

# Makes your browser the administrator when you open  BASE_URL/admin/<ADMIN_KEY>
ADMIN_KEY=pick-a-long-secret-word

# Google sign-in (recommended). Create an OAuth "Web application" client in Google Cloud Console,
# add  BASE_URL/auth/google/callback  as an authorised redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# If set, signing in with this Google account makes you the administrator automatically.
OWNER_EMAIL=kattavenkatabhargavaram@gmail.com

# Allow joining with just a name (no Google). Those members are marked "name only / unverified".
ALLOW_ANON=0

# AI reviews for suggestions (administrator only). Leave empty to disable.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
